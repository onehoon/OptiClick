<UserControl x:Class="OptiClick.Wpf.Views.Sections.GameCoverCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Button Command="{Binding SelectGameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
            CommandParameter="{Binding}"
            Style="{StaticResource CoverCardButtonStyle}"
            Width="{Binding CardWidth}"
            Height="{Binding CardHeight}"
            Visibility="{Binding CardLayoutVisibility}"
            Opacity="{Binding CardOpacity}"
            ToolTipService.IsEnabled="False">
        <Button.ToolTip>
            <StackPanel>
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding StatusBadge}" />
            </StackPanel>
        </Button.ToolTip>
        <Border Width="{Binding CardWidth}"
                Height="{Binding CardHeight}"
                Background="{Binding CoverBrush}"
                BorderBrush="Transparent"
                BorderThickness="0"
                CornerRadius="0"
                ClipToBounds="True">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource CoverSelectedStrokeBrush}" />
                            <Setter Property="BorderThickness" Value="3" />
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="22"
                                                      ShadowDepth="0"
                                                      Opacity="0.34"
                                                      Color="{StaticResource CoverSelectedStrokeColor}" />
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Image Source="{Binding CoverImage}"
                       Stretch="UniformToFill"
                       SnapsToDevicePixels="True"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Opacity="1" />
                <Rectangle Fill="{StaticResource CoverSelectedOverlayBrush}"
                           Visibility="Collapsed">
                    <Rectangle.Style>
                        <Style TargetType="Rectangle">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Rectangle.Style>
                </Rectangle>
                <Border BorderBrush="{StaticResource CoverSelectedInnerStrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="0"
                        Margin="3"
                        Visibility="Collapsed"
                        IsHitTestVisible="False">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
                <Rectangle VerticalAlignment="Top"
                           Height="88"
                           Opacity="0.08">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FFFFFFFF" Offset="0" />
                            <GradientStop Color="#00FFFFFF" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle VerticalAlignment="Bottom"
                           Height="72"
                           Opacity="0.10">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00000000" Offset="0" />
                            <GradientStop Color="#88000000" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Border Background="{Binding BadgeBrush}"
                        BorderBrush="{Binding BadgeBorderBrush}"
                        BorderThickness="2"
                        CornerRadius="10"
                        Padding="10,4"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="10,8,8,10">
                    <TextBlock Text="{Binding StatusBadge}"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="{Binding BadgeForegroundBrush}" />
                </Border>
                <Border Width="22"
                        Height="22"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="9"
                        CornerRadius="11"
                        Background="{StaticResource CoverSelectedStrokeBrush}"
                        Visibility="Collapsed"
                        IsHitTestVisible="False">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="✓"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="12"
                               FontWeight="Bold" />
                </Border>
            </Grid>
        </Border>
    </Button>
</UserControl>
