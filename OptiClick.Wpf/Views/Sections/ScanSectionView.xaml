<UserControl x:Class="OptiClick.Wpf.Views.Sections.ScanSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources>
        <Style x:Key="ScanFolderNameTextStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="ScanFolderPathTextStyle" TargetType="TextBlock" BasedOn="{StaticResource DescriptionTextStyle}">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>

        <Style x:Key="ScanFolderGroupHeaderStyle" TargetType="Grid">
            <Setter Property="Margin" Value="0,16,0,8" />
        </Style>

        <Style x:Key="ScanFolderStatusPillStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ScanFolderItemContainerStyle" TargetType="ContentPresenter">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Style="{StaticResource PageHeaderPanelStyle}">
            <TextBlock Text="{Binding Strings.ScanTitle}" Style="{StaticResource PageTitleTextStyle}" />
            <TextBlock Text="{Binding Strings.ScanDescription}"
                       Style="{StaticResource PageDescriptionTextStyle}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      Padding="0,0,10,0">
            <StackPanel>
                <ui:Card Style="{StaticResource RaisedPanelCardControlStyle}"
                         Padding="22"
                         Margin="0,0,18,14"
                         HorizontalAlignment="Stretch">
                    <Grid MinHeight="108">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Width="46"
                                Height="46"
                                CornerRadius="12"
                                Background="{StaticResource SurfaceHoverBrush}"
                                VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="FolderAdd24"
                                           Foreground="{StaticResource AccentPrimaryBrush}"
                                           FontSize="24"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="2"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{Binding Strings.ScanAddFolderCardTitle}"
                                       Style="{StaticResource SectionTitleTextStyle}" />
                            <TextBlock Text="{Binding Strings.ScanAddFolderCardDescription}"
                                       Style="{StaticResource SectionDescriptionTextStyle}"
                                       Margin="0,7,0,0" />
                        </StackPanel>

                        <Button Grid.Column="4"
                                Content="{Binding Strings.ScanAddFolder}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding AddScanFolderCommand}"
                                VerticalAlignment="Center" />
                    </Grid>
                </ui:Card>

                <ui:Card Style="{StaticResource PanelCardControlStyle}"
                         Padding="18"
                         Margin="0,0,18,0"
                         HorizontalAlignment="Stretch">
                    <StackPanel>
                        <Grid Style="{StaticResource ScanFolderGroupHeaderStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0"
                                           Symbol="Search24"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="18"
                                           VerticalAlignment="Center" />
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{Binding Strings.ScanDefaultFoldersTitle}"
                                           Style="{StaticResource SectionTitleTextStyle}"
                                           FontSize="14" />
                                <TextBlock Text="{Binding Strings.ScanDefaultFoldersDescription}"
                                           Style="{StaticResource SmallDescriptionTextStyle}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{Binding Strings.ScanNoDefaultFolders}"
                                   Visibility="{Binding DefaultFoldersEmptyVisibility}"
                                   Style="{StaticResource DescriptionTextStyle}"
                                   Margin="28,4,0,8" />
                        <ItemsControl ItemsSource="{Binding DefaultFolders}"
                                      ItemContainerStyle="{StaticResource ScanFolderItemContainerStyle}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ui:Card Style="{StaticResource SectionListItemCardControlStyle}"
                                             HorizontalAlignment="Stretch">
                                        <Grid MinHeight="54" ClipToBounds="True">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <ui:ToggleSwitch Grid.Column="0"
                                                             VerticalAlignment="Center"
                                                             IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             OnContent=""
                                                             OffContent="" />

                                            <StackPanel Grid.Column="2"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}"
                                                           Style="{StaticResource ScanFolderNameTextStyle}"
                                                           ToolTip="{Binding Name}" />
                                                <TextBlock Text="{Binding Path}"
                                                           Style="{StaticResource ScanFolderPathTextStyle}"
                                                           Foreground="{Binding PathForeground}"
                                                           ToolTip="{Binding Path}"
                                                           Margin="0,3,0,0" />
                                            </StackPanel>

                                            <Border Grid.Column="4"
                                                    Style="{StaticResource ScanFolderStatusPillStyle}"
                                                    Background="{Binding StatusBackground}">
                                                <TextBlock Text="{Binding Status}"
                                                           Foreground="{Binding StatusForeground}"
                                                           FontSize="11.5"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Border>
                                        </Grid>
                                    </ui:Card>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid Style="{StaticResource ScanFolderGroupHeaderStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0"
                                           Symbol="Folder24"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="18"
                                           VerticalAlignment="Center" />
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{Binding Strings.ScanAddedFoldersTitle}"
                                           Style="{StaticResource SectionTitleTextStyle}"
                                           FontSize="14" />
                                <TextBlock Text="{Binding Strings.ScanAddedFoldersDescription}"
                                           Style="{StaticResource SmallDescriptionTextStyle}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{Binding Strings.ScanNoAddedFoldersHint}"
                                   Visibility="{Binding AddedFoldersEmptyVisibility}"
                                   Style="{StaticResource DescriptionTextStyle}"
                                   Margin="28,4,0,8" />
                        <ItemsControl ItemsSource="{Binding AddedFolders}"
                                      ItemContainerStyle="{StaticResource ScanFolderItemContainerStyle}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ui:Card Style="{StaticResource SectionListItemCardControlStyle}"
                                             HorizontalAlignment="Stretch">
                                        <Grid MinHeight="54" ClipToBounds="True">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <ui:ToggleSwitch Grid.Column="0"
                                                             VerticalAlignment="Center"
                                                             IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             OnContent=""
                                                             OffContent="" />

                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Path}"
                                                       Style="{StaticResource ScanFolderNameTextStyle}"
                                                       Foreground="{Binding PathForeground}"
                                                       ToolTip="{Binding Path}"
                                                       VerticalAlignment="Center" />

                                            <Border Grid.Column="4"
                                                    Style="{StaticResource ScanFolderStatusPillStyle}"
                                                    Background="{Binding StatusBackground}"
                                                    Visibility="{Binding MissingVisibility}">
                                                <TextBlock Text="{Binding Status}"
                                                           Foreground="{Binding StatusForeground}"
                                                           FontSize="11.5"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Border>

                                            <Button Grid.Column="6"
                                                    Content="{Binding DataContext.Strings.ScanRemoveFolderTooltip, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    Style="{StaticResource GhostButtonStyle}"
                                                    MinWidth="76"
                                                    Visibility="{Binding CanRemove, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    Command="{Binding DataContext.RemoveScanFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    VerticalAlignment="Center"
                                                    Margin="0" />
                                        </Grid>
                                    </ui:Card>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ui:Card>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2"
              Margin="0,14,18,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="{StaticResource ActionButtonGapLength}" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="{Binding Strings.ScanCancel}"
                    Style="{StaticResource GhostButtonStyle}"
                    MinWidth="90"
                    Command="{Binding ShowHomeCommand}" />

            <TextBlock Grid.Column="2"
                       Text="{Binding ScanStatusText}"
                       Style="{StaticResource DescriptionTextStyle}"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       TextAlignment="Right"
                       TextTrimming="CharacterEllipsis" />

            <Button Grid.Column="4"
                    Content="{Binding Strings.ScanSaveAndScan}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    MinWidth="128"
                    Command="{Binding SaveAndScanCommand}" />
        </Grid>
    </Grid>
</UserControl>
