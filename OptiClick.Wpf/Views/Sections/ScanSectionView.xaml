<UserControl x:Class="OptiClick.Wpf.Views.Sections.ScanSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources>
        <Style x:Key="ScanFolderNameTextStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style x:Key="ScanFolderPathTextStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="14" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,4,0,14">
            <TextBlock Text="{Binding Strings.ScanTitle}" Style="{StaticResource PageTitleTextStyle}" />
        </Grid>

        <ui:Card Grid.Row="1"
                 Style="{StaticResource PanelCardControlStyle}"
                 Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="True"
                          Padding="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="{Binding Strings.ScanDefaultFoldersTitle}"
                               Style="{StaticResource SectionTitleTextStyle}" />
                    <TextBlock Text="{Binding Strings.ScanNoDefaultFolders}"
                               Visibility="{Binding DefaultFoldersEmptyVisibility}"
                               Style="{StaticResource DescriptionTextStyle}"
                               Margin="0,8,0,0" />
                    <ItemsControl ItemsSource="{Binding DefaultFolders}"
                                  Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ui:Card Style="{StaticResource SectionListItemCardControlStyle}">
                                    <Grid MinHeight="46" ClipToBounds="True">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <ui:ToggleSwitch Grid.Column="0"
                                                         VerticalAlignment="Center"
                                                         IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         OnContent=""
                                                         OffContent="" />

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Name}"
                                                   Style="{StaticResource ScanFolderNameTextStyle}"
                                                   VerticalAlignment="Center"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Name}" />

                                        <TextBlock Grid.Column="4"
                                                   Text="{Binding Path}"
                                                   Style="{StaticResource ScanFolderPathTextStyle}"
                                                   Foreground="{Binding PathForeground}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Path}" />
                                    </Grid>
                                </ui:Card>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{Binding Strings.ScanAddedFoldersTitle}"
                               Style="{StaticResource SectionTitleTextStyle}"
                               Margin="0,16,0,0" />
                    <TextBlock Text="{Binding Strings.ScanNoAddedFolders}"
                               Visibility="{Binding AddedFoldersEmptyVisibility}"
                               Style="{StaticResource DescriptionTextStyle}"
                               Margin="0,8,0,0" />
                    <ItemsControl ItemsSource="{Binding AddedFolders}"
                                   Margin="0,10,0,0"
                                   Width="780"
                                   HorizontalAlignment="Left">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ui:Card Style="{StaticResource SectionListItemCardControlStyle}">
                                    <Grid MinHeight="46"
                                          Width="760"
                                          HorizontalAlignment="Left"
                                          ClipToBounds="True">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="20" />
                                            <ColumnDefinition Width="420" />
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <ui:ToggleSwitch Grid.Column="0"
                                                         VerticalAlignment="Center"
                                                         IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         OnContent=""
                                                         OffContent="" />

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Path}"
                                                   Style="{StaticResource ScanFolderPathTextStyle}"
                                                   Foreground="{Binding PathForeground}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Path}" />

                                        <Button Grid.Column="4"
                                                Content="{Binding DataContext.Strings.ScanRemoveFolderTooltip, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Style="{StaticResource GhostButtonStyle}"
                                                MinWidth="92"
                                                Visibility="{Binding CanRemove, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                Command="{Binding DataContext.RemoveScanFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                VerticalAlignment="Center"
                                                Margin="0"
                                                HorizontalAlignment="Left" />
                                    </Grid>
                                </ui:Card>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </ui:Card>

        <Grid Grid.Row="2"
              Margin="0,18,34,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="{StaticResource ActionButtonGapLength}" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="{Binding Strings.ScanAddFolder}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding AddScanFolderCommand}" />

            <Button Grid.Column="2"
                    Content="{Binding Strings.ScanCancel}"
                    Style="{StaticResource GhostButtonStyle}"
                    MinWidth="90"
                    Command="{Binding ShowHomeCommand}" />
            <Button Grid.Column="4"
                    Content="{Binding Strings.ScanSaveAndScan}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    MinWidth="128"
                    Command="{Binding SaveAndScanCommand}" />
        </Grid>
    </Grid>
</UserControl>
