<UserControl x:Class="OptiClick.Wpf.Views.Sections.SettingsSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="SettingsTitleTextStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource PageTitleTextStyle}">
            <Setter Property="FontSize" Value="25" />
        </Style>

        <Style x:Key="SettingsRowLabelTextStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource FieldLabelTextStyle}">
            <Setter Property="FontSize" Value="16" />
        </Style>

        <Style x:Key="SettingsRowContainerStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="SettingsLanguageComboBoxStyle"
               TargetType="ComboBox"
               BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Width" Value="120" />
            <Setter Property="MinWidth" Value="120" />
            <Setter Property="Height" Value="36" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="IsEditable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsActionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Width" Value="120" />
            <Setter Property="MinWidth" Value="120" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Style="{StaticResource PageHeaderPanelStyle}">
            <TextBlock Text="{Binding Strings.SettingsTitle}" Style="{StaticResource SettingsTitleTextStyle}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="40,4,0,0"
                        Width="680"
                        HorizontalAlignment="Left">
                <Border Style="{StaticResource SettingsRowContainerStyle}">
                    <Grid Height="54">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="320" />
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Strings.SettingsLanguage}"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource SettingsRowLabelTextStyle}" />
                        <ComboBox Grid.Column="2"
                                  Style="{StaticResource SettingsLanguageComboBoxStyle}"
                                  ItemsSource="{Binding SettingsLanguageOptions}"
                                  SelectedItem="{Binding SelectedSettingsLanguageOption, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsRowContainerStyle}">
                    <Grid Height="54">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="320" />
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding SettingsLogFolderLabel}"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource SettingsRowLabelTextStyle}" />
                        <Button Grid.Column="2"
                                Content="{Binding SettingsActionOpenLabel}"
                                Style="{StaticResource SettingsActionButtonStyle}"
                                Command="{Binding OpenLogFolderCommand}" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsRowContainerStyle}">
                    <Grid Height="54">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="320" />
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding SettingsRefreshInstallFilesLabel}"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource SettingsRowLabelTextStyle}" />
                        <Button Grid.Column="2"
                                Content="{Binding SettingsActionRunLabel}"
                                Style="{StaticResource SettingsActionButtonStyle}"
                                Command="{Binding RefreshInstallFilesCommand}" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsRowContainerStyle}">
                    <Grid Height="54">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="320" />
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding SettingsGitHubLabel}"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource SettingsRowLabelTextStyle}" />
                        <Button Grid.Column="2"
                                Content="{Binding SettingsActionOpenLabel}"
                                Style="{StaticResource SettingsActionButtonStyle}"
                                Command="{Binding OpenSupportRequestCommand}" />
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
