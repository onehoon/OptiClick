<UserControl x:Class="OptiClick.Wpf.Views.Sections.SettingsSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources>
        <Style x:Key="SettingsItemCardControlStyle"
               TargetType="ui:Card"
               BasedOn="{StaticResource SectionListItemCardControlStyle}">
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="SettingsItemContainerStyle" TargetType="ContentPresenter">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>

        <Style x:Key="SettingsIconPanelStyle" TargetType="Border">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SettingsLanguageComboBoxStyle"
               TargetType="ComboBox"
               BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="MinWidth" Value="132" />
            <Setter Property="Height" Value="36" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="IsEditable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsActionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Style="{StaticResource PageHeaderPanelStyle}">
            <TextBlock Text="{Binding Strings.SettingsTitle}" Style="{StaticResource PageTitleTextStyle}" />
            <TextBlock Text="{Binding Strings.SettingsDescription}"
                       Style="{StaticResource PageDescriptionTextStyle}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,10,0">
            <StackPanel Margin="0,0,18,0"
                        HorizontalAlignment="Stretch">
                <TextBlock Text="{Binding Strings.SettingsGeneralSectionTitle}"
                           Style="{StaticResource SectionTitleTextStyle}"
                           Margin="0,0,0,8" />
                <ui:Card Style="{StaticResource SettingsItemCardControlStyle}"
                         HorizontalAlignment="Stretch">
                    <Grid MinHeight="56">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource SettingsIconPanelStyle}">
                            <ui:SymbolIcon Symbol="LocalLanguage24"
                                           Foreground="{StaticResource AccentPrimaryBrush}"
                                           FontSize="20"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="2"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{Binding Strings.SettingsLanguage}"
                                       Style="{StaticResource SectionTitleTextStyle}"
                                       FontSize="14" />
                            <TextBlock Text="{Binding Strings.SettingsLanguageDescription}"
                                       Style="{StaticResource SmallDescriptionTextStyle}"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <ComboBox Grid.Column="4"
                                  Style="{StaticResource SettingsLanguageComboBoxStyle}"
                                  ItemsSource="{Binding SettingsLanguageOptions}"
                                  SelectedItem="{Binding SelectedSettingsLanguageOption, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                </ui:Card>

                <ui:Card Style="{StaticResource SettingsItemCardControlStyle}"
                         HorizontalAlignment="Stretch">
                    <Grid MinHeight="56">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource SettingsIconPanelStyle}">
                            <ui:SymbolIcon Symbol="Settings24"
                                           Foreground="{StaticResource AccentPrimaryBrush}"
                                           FontSize="20"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="2"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{Binding Strings.SettingsOptiScalerVersionTitle}"
                                       Style="{StaticResource SectionTitleTextStyle}"
                                       FontSize="14" />
                            <TextBlock Text="{Binding Strings.SettingsOptiScalerVersionDescription}"
                                       Style="{StaticResource SmallDescriptionTextStyle}"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <ComboBox Grid.Column="4"
                                  Style="{StaticResource SettingsLanguageComboBoxStyle}"
                                  MinWidth="180"
                                  ItemsSource="{Binding OptiScalerVariantOptions}"
                                  DisplayMemberPath="DisplayLabel"
                                  SelectedValuePath="Variant"
                                  SelectedValue="{Binding SelectedOptiScalerVariantOption, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                </ui:Card>

                <TextBlock Text="{Binding Strings.SettingsManagementSectionTitle}"
                           Style="{StaticResource SectionTitleTextStyle}"
                           Margin="0,18,0,8" />
                <ui:Card Style="{StaticResource SettingsItemCardControlStyle}"
                         HorizontalAlignment="Stretch">
                    <Grid MinHeight="56">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource SettingsIconPanelStyle}">
                            <ui:SymbolIcon Symbol="Folder24"
                                           Foreground="{StaticResource AccentPrimaryBrush}"
                                           FontSize="20"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="2"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{Binding Strings.SettingsLogFolderTitle}"
                                       Style="{StaticResource SectionTitleTextStyle}"
                                       FontSize="14" />
                            <TextBlock Text="{Binding Strings.SettingsLogFolderDescription}"
                                       Style="{StaticResource SmallDescriptionTextStyle}"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <Button Grid.Column="4"
                                Content="{Binding Strings.SettingsActionOpen}"
                                Style="{StaticResource SettingsActionButtonStyle}"
                                Command="{Binding OpenLogFolderCommand}" />
                    </Grid>
                </ui:Card>

                <ui:Card Style="{StaticResource SettingsItemCardControlStyle}"
                         HorizontalAlignment="Stretch">
                    <Grid MinHeight="56">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource SettingsIconPanelStyle}">
                            <ui:SymbolIcon Symbol="ArrowClockwise24"
                                           Foreground="{StaticResource AccentPrimaryBrush}"
                                           FontSize="20"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="2"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{Binding Strings.SettingsInstallFileCacheTitle}"
                                       Style="{StaticResource SectionTitleTextStyle}"
                                       FontSize="14" />
                            <TextBlock Text="{Binding Strings.SettingsInstallFileCacheDescription}"
                                       Style="{StaticResource SmallDescriptionTextStyle}"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <Button Grid.Column="4"
                                Content="{Binding Strings.SettingsActionReset}"
                                Style="{StaticResource SettingsActionButtonStyle}"
                                Command="{Binding RefreshInstallFilesCommand}" />
                    </Grid>
                </ui:Card>

                <TextBlock Text="{Binding SettingsStatusText}"
                           Style="{StaticResource SmallDescriptionTextStyle}"
                           Margin="2,0,0,8" />

                <TextBlock Text="{Binding Strings.SettingsSupportSectionTitle}"
                           Style="{StaticResource SectionTitleTextStyle}"
                           Margin="0,18,0,8" />
                <ui:Card Style="{StaticResource SettingsItemCardControlStyle}"
                         HorizontalAlignment="Stretch">
                    <Grid MinHeight="56">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource SettingsIconPanelStyle}">
                            <ui:SymbolIcon Symbol="QuestionCircle24"
                                           Foreground="{StaticResource AccentPrimaryBrush}"
                                           FontSize="20"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="2"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{Binding Strings.SettingsGitHubSupportTitle}"
                                       Style="{StaticResource SectionTitleTextStyle}"
                                       FontSize="14" />
                            <TextBlock Text="{Binding Strings.SettingsGitHubSupportDescription}"
                                       Style="{StaticResource SmallDescriptionTextStyle}"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <Button Grid.Column="4"
                                Content="{Binding Strings.SettingsActionOpen}"
                                Style="{StaticResource SettingsActionButtonStyle}"
                                Command="{Binding OpenSupportRequestCommand}" />
                    </Grid>
                </ui:Card>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
