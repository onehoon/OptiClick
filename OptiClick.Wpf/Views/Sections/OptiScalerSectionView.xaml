<UserControl x:Class="OptiClick.Wpf.Views.Sections.OptiScalerSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources>
        <Style x:Key="OptiScalerCardControlStyle"
               TargetType="ui:Card"
               BasedOn="{StaticResource SectionListItemCardControlStyle}">
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="0,0,0,0" />
        </Style>

        <Style x:Key="OptiScalerIconPanelStyle" TargetType="Border">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="OptiScalerHeaderIconPanelStyle"
               TargetType="Border"
               BasedOn="{StaticResource OptiScalerIconPanelStyle}">
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,13,0,0" />
        </Style>

        <Style x:Key="OptiScalerComboBoxStyle"
               TargetType="ComboBox"
               BasedOn="{StaticResource FluentCompactComboBoxStyle}">
            <Setter Property="Width" Value="145" />
            <Setter Property="MinWidth" Value="145" />
        </Style>

        <Style x:Key="OptiScalerSaveButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource PrimaryButtonStyle}" />
    </UserControl.Resources>

    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,12,13,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="{Binding Strings.OptiScalerTitle}"
                           Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Text="{Binding Strings.OptiScalerDescription}"
                           Style="{StaticResource PageDescriptionTextStyle}" />
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <TextBlock Text="{Binding StatusText}"
                           Style="{StaticResource SmallDescriptionTextStyle}"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0" />
                <Button Content="{Binding Strings.OptiScalerSaveButton}"
                        Style="{StaticResource OptiScalerSaveButtonStyle}"
                        Command="{Binding SaveCommand}" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,10,0">
            <StackPanel Margin="0,0,0,0"
                        HorizontalAlignment="Stretch">
                <ui:Card Style="{StaticResource OptiScalerCardControlStyle}"
                         HorizontalAlignment="Stretch">
                    <Grid MinHeight="62">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource OptiScalerIconPanelStyle}">
                            <ui:SymbolIcon Symbol="ArrowClockwise24"
                                           Foreground="{DynamicResource AccentPrimaryBrush}"
                                           FontSize="20"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="2"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{Binding Strings.OptiScalerVersionTitle}"
                                       Style="{StaticResource SectionTitleTextStyle}"
                                       FontSize="15" />
                            <TextBlock Text="{Binding Strings.OptiScalerVersionDescription}"
                                       Style="{StaticResource SmallDescriptionTextStyle}"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <ComboBox Grid.Column="4"
                                  Style="{StaticResource OptiScalerComboBoxStyle}"
                                  ItemsSource="{Binding OptiScalerVariantOptions}"
                                  DisplayMemberPath="DisplayLabel"
                                  SelectedValuePath="Variant"
                                  SelectedValue="{Binding SelectedOptiScalerVariantOption, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                </ui:Card>

                <ui:Card Style="{StaticResource OptiScalerCardControlStyle}"
                         HorizontalAlignment="Stretch"
                         Margin="0,6,0,0">
                    <Grid MinHeight="62">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource OptiScalerIconPanelStyle}">
                            <ui:SymbolIcon Symbol="Settings24"
                                           Foreground="{DynamicResource AccentPrimaryBrush}"
                                           FontSize="20"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="2"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{Binding Strings.OptiScalerMenuTitle}"
                                       Style="{StaticResource SectionTitleTextStyle}"
                                       FontSize="15" />
                            <TextBlock Text="{Binding Strings.OptiScalerMenuDescription}"
                                       Style="{StaticResource SmallDescriptionTextStyle}"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="4"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <ComboBox Style="{StaticResource OptiScalerComboBoxStyle}"
                                      ItemsSource="{Binding MenuScaleOptions}"
                                      DisplayMemberPath="DisplayText"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding SelectedMenuScale, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>
                </ui:Card>

                <ui:Card Style="{StaticResource OptiScalerCardControlStyle}"
                         HorizontalAlignment="Stretch"
                         Margin="0,6,0,0">
                    <Grid MinHeight="62">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource OptiScalerIconPanelStyle}">
                            <ui:SymbolIcon Symbol="ChatMultiple24"
                                           Foreground="{DynamicResource AccentPrimaryBrush}"
                                           FontSize="20"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="2"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{Binding Strings.OptiScalerStartupTitle}"
                                       Style="{StaticResource SectionTitleTextStyle}"
                                       FontSize="15" />
                            <TextBlock Text="{Binding Strings.OptiScalerStartupDescription}"
                                       Style="{StaticResource SmallDescriptionTextStyle}"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <ComboBox Grid.Column="4"
                                  Style="{StaticResource OptiScalerComboBoxStyle}"
                                  ItemsSource="{Binding SplashOptions}"
                                  DisplayMemberPath="DisplayText"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding SelectedDisableSplashMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                </ui:Card>

                <ui:Card Style="{StaticResource OptiScalerCardControlStyle}"
                         HorizontalAlignment="Stretch"
                         Margin="0,6,0,0">
                    <Grid MinHeight="62">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource OptiScalerIconPanelStyle}">
                            <ui:SymbolIcon Symbol="Gauge24"
                                           Foreground="{DynamicResource AccentPrimaryBrush}"
                                           FontSize="20"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                        </Border>

                        <Grid Grid.Column="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding Strings.OptiScalerFramerateTitle}"
                                           Style="{StaticResource SectionTitleTextStyle}"
                                           FontSize="15" />
                                <TextBlock Text="{Binding Strings.OptiScalerFramerateDescription}"
                                           Style="{StaticResource SmallDescriptionTextStyle}"
                                           Margin="0,4,0,0" />
                            </StackPanel>

                            <ComboBox Grid.Column="2"
                                      Style="{StaticResource OptiScalerComboBoxStyle}"
                                      ItemsSource="{Binding FramerateLimitOptions}"
                                      DisplayMemberPath="DisplayText"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding SelectedFramerateLimit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                    </Grid>
                </ui:Card>

                <ui:Card Style="{StaticResource OptiScalerCardControlStyle}"
                         HorizontalAlignment="Stretch"
                         Margin="0,6,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource OptiScalerHeaderIconPanelStyle}">
                            <ui:SymbolIcon Symbol="XboxController24"
                                           Foreground="{DynamicResource AccentPrimaryBrush}"
                                           FontSize="20"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="2">
                            <Grid MinHeight="62">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Strings.OptiScalerFpsOverlayTitle}"
                                               Style="{StaticResource SectionTitleTextStyle}"
                                               FontSize="15" />
                                    <TextBlock Text="{Binding Strings.OptiScalerFpsOverlayDescription}"
                                               Style="{StaticResource SmallDescriptionTextStyle}"
                                               Margin="0,4,0,0" />
                                </StackPanel>

                                <ComboBox Grid.Column="2"
                                          Style="{StaticResource OptiScalerComboBoxStyle}"
                                          ItemsSource="{Binding FpsDisplayOptions}"
                                          DisplayMemberPath="DisplayText"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding SelectedShowFpsMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>

                            <Grid Margin="0,6,0,0"
                                  Visibility="{Binding IsFpsOverlayDetailsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0"
                                      HorizontalAlignment="Right">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Strings.OptiScalerOverlayType}"
                                               Style="{StaticResource FieldLabelTextStyle}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0" />
                                    <ComboBox Grid.Column="1"
                                              Style="{StaticResource OptiScalerComboBoxStyle}"
                                              ItemsSource="{Binding FpsOverlayTypeOptions}"
                                              DisplayMemberPath="DisplayText"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding SelectedFpsOverlayType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>

                                <Grid Grid.Column="2"
                                      HorizontalAlignment="Right">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Strings.OptiScalerOverlayPosition}"
                                               Style="{StaticResource FieldLabelTextStyle}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0" />
                                    <ComboBox Grid.Column="1"
                                              Style="{StaticResource OptiScalerComboBoxStyle}"
                                              ItemsSource="{Binding FpsOverlayPositionOptions}"
                                              DisplayMemberPath="DisplayText"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding SelectedFpsOverlayPos, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>

                                <Grid Grid.Column="4"
                                      HorizontalAlignment="Right">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Strings.OptiScalerOverlayScale}"
                                               Style="{StaticResource FieldLabelTextStyle}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0" />
                                    <ComboBox Grid.Column="1"
                                              Style="{StaticResource OptiScalerComboBoxStyle}"
                                              ItemsSource="{Binding FpsScaleOptions}"
                                              DisplayMemberPath="DisplayText"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding SelectedFpsScale, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </ui:Card>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
