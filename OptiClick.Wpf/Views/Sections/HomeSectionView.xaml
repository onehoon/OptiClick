<UserControl x:Class="OptiClick.Wpf.Views.Sections.HomeSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:OptiClick.Wpf.Controls"
             xmlns:sections="clr-namespace:OptiClick.Wpf.Views.Sections"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources>
        <SolidColorBrush x:Key="SelectedGameTitleIceBlueBrush" Color="#DCEBFF" />
        <Thickness x:Key="HomeGridRightInset">0,0,18,0</Thickness>
    </UserControl.Resources>
    <Grid x:Name="HomeSectionRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="{StaticResource ShellHeaderRowHeight}" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:Card Grid.Row="0"
                 Style="{StaticResource PanelCardControlStyle}"
                 Background="Transparent"
                 BorderBrush="Transparent"
                 BorderThickness="0"
                 Padding="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedGameAction.HasSelectedGame}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding SelectedGameAction.SelectedGameTitle}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource SelectedGameTitleIceBlueBrush}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Margin="0,2,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedGameAction.HasSelectedGame}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HasGamesForHomeSelectionMessage}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="{Binding Strings.HomeNoGameSelected}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource InkBrush}" />
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Column="1"
                      Margin="{StaticResource HomeGridRightInset}"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Right">
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedGameAction.HasSelectedGame}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Content="{Binding SelectedGameAction.InstallButtonText}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding ShowInstallCommand}"
                                MinWidth="128"
                                IsEnabled="{Binding SelectedGameAction.IsInstallButtonEnabled}" />
                    </Grid>
                </Grid>
            </Grid>
        </ui:Card>

        <ScrollViewer x:Name="HomeGamesScrollViewer"
                      Grid.Row="1"
                      Margin="{StaticResource ActionRowMargin}"
                      HorizontalAlignment="Stretch"
                      Background="{StaticResource AppBackgroundBrush}"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalContentAlignment="Top"
                      ScrollChanged="HomeGamesScrollViewer_OnScrollChanged"
                      SizeChanged="HomeGamesScrollViewer_OnSizeChanged">
            <ItemsControl x:Name="HomeGamesItemsControl"
                          ItemsSource="{Binding Games}"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Top"
                          Margin="{StaticResource HomeGridRightInset}">
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                        <Setter Property="VerticalAlignment" Value="Top" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <controls:HomeCoverGridPanel VerticalAlignment="Top" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <sections:GameCoverCardView SelectGameCommand="{Binding DataContext.SelectGameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
