<UserControl x:Class="OptiClick.Wpf.Views.Sections.SupportedGamesWikiSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:services="clr-namespace:OptiClick.Wpf.Services">
    <UserControl.Resources>
        <Thickness x:Key="WikiSearchBoxMargin">0,10,18,0</Thickness>
        <Thickness x:Key="WikiRowRightInset">0,0,12,0</Thickness>
        <Thickness x:Key="WikiCardMargin">0,0,0,8</Thickness>
        <Thickness x:Key="WikiCardPadding">8</Thickness>
        <Thickness x:Key="WikiVendorBadgePadding">8,5</Thickness>
        <CornerRadius x:Key="WikiCardCornerRadius">10</CornerRadius>
        <CornerRadius x:Key="WikiCoverCornerRadius">8</CornerRadius>
        <CornerRadius x:Key="WikiVendorBadgeCornerRadius">8</CornerRadius>
        <SolidColorBrush x:Key="WikiVendorIntelBrush" Color="#68AEEB" />
        <SolidColorBrush x:Key="WikiVendorAmdBrush" Color="#E07880" />
        <SolidColorBrush x:Key="WikiVendorNvidiaBrush" Color="#8ACB43" />

        <Style x:Key="RequestGameSupportButtonStyle" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource SupportedGamesInputBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SupportedGamesCardBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinHeight" Value="36" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SupportedGamesCardHoverBackgroundBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentSecondaryBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SupportedGamesSearchBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Background" Value="{DynamicResource SupportedGamesInputBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource AccentPrimaryBrush}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource SurfaceHoverBrush}" />
            <Setter Property="Padding" Value="12,8,38,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="SearchBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="9" />
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SearchBorder" Property="Background" Value="{DynamicResource SupportedGamesCardBackgroundBrush}" />
                                <Setter TargetName="SearchBorder" Property="BorderBrush" Value="{DynamicResource SupportedGamesCardHoverBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="SearchBorder" Property="Background" Value="{DynamicResource SupportedGamesCardBackgroundBrush}" />
                                <Setter TargetName="SearchBorder" Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="SearchBorder" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SupportedGamesSearchClearButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="MinWidth" Value="28" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WikiGameTitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="15.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="MinWidth" Value="0" />
        </Style>

        <Style x:Key="WikiVendorLabelTextStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="LineHeight" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="WikiVendorValueTextStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="LineHeight" Value="16" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextTrimming" Value="None" />
            <Setter Property="MinWidth" Value="0" />
        </Style>

        <Style x:Key="WikiVendorIntelTextStyle" TargetType="TextBlock" BasedOn="{StaticResource WikiVendorLabelTextStyle}">
            <Setter Property="Foreground" Value="{StaticResource WikiVendorIntelBrush}" />
        </Style>

        <Style x:Key="WikiVendorAmdTextStyle" TargetType="TextBlock" BasedOn="{StaticResource WikiVendorLabelTextStyle}">
            <Setter Property="Foreground" Value="{StaticResource WikiVendorAmdBrush}" />
        </Style>

        <Style x:Key="WikiVendorNvidiaTextStyle" TargetType="TextBlock" BasedOn="{StaticResource WikiVendorLabelTextStyle}">
            <Setter Property="Foreground" Value="{StaticResource WikiVendorNvidiaBrush}" />
        </Style>

        <Style x:Key="SupportedGamesItemCardStyle" TargetType="Border">
            <Setter Property="Margin" Value="{StaticResource WikiCardMargin}" />
            <Setter Property="Padding" Value="{StaticResource WikiCardPadding}" />
            <Setter Property="MinHeight" Value="{x:Static services:SupportedGamesWikiLayoutProfile.DefaultRowHeightDip}" />
            <Setter Property="Background" Value="{DynamicResource SupportedGamesCardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SupportedGamesCardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource WikiCardCornerRadius}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Cursor" Value="Arrow" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SupportedGamesCardHoverBackgroundBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource SupportedGamesCardHoverBorderBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WikiCoverFrameStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SupportedGamesCoverBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SupportedGamesBadgeBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource WikiCoverCornerRadius}" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
        </Style>

        <Style x:Key="WikiVendorBadgeStyle" TargetType="Border">
            <Setter Property="Padding" Value="{StaticResource WikiVendorBadgePadding}" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Background" Value="{DynamicResource SupportedGamesBadgeBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SupportedGamesBadgeBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource WikiVendorBadgeCornerRadius}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource SupportedGamesPageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Margin="0,2,0,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0"
                       Grid.Column="0"
                       Text="{Binding Strings.SupportedGamesWikiTitle}"
                       Style="{StaticResource PageTitleTextStyle}" />

            <ui:Button Grid.Row="0"
                       Grid.Column="1"
                       Margin="0,0,18,0"
                       Command="{Binding OpenGameSupportRequestCommand}"
                       ToolTip="{Binding Strings.SupportedGamesWikiRequestGameTooltip}"
                       Style="{StaticResource RequestGameSupportButtonStyle}">
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="ChatMultiple24"
                                   Width="16"
                                   Height="16"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                   Margin="0,0,8,0" />
                    <TextBlock Margin="0,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding Strings.SupportedGamesWikiRequestGame}" />
                </StackPanel>
            </ui:Button>

            <Grid Grid.Row="1"
                  Grid.ColumnSpan="2"
                  Margin="{StaticResource WikiSearchBoxMargin}">
                <TextBox x:Name="SupportedGamesSearchBox"
                         MinHeight="38"
                         HorizontalAlignment="Stretch"
                         VerticalContentAlignment="Center"
                         Style="{StaticResource SupportedGamesSearchBoxStyle}"
                         ToolTip="{Binding Strings.SupportedGamesWikiSearchPlaceholder}"
                         Text="{Binding SupportedGamesWikiSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Margin="13,0,0,0"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Foreground="{DynamicResource TextMutedBrush}"
                           FontStyle="Italic"
                           Opacity="0.85"
                           Text="{Binding Strings.SupportedGamesWikiSearchWatermark}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=SupportedGamesSearchBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=SupportedGamesSearchBox}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Button Margin="0,0,6,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Style="{StaticResource SupportedGamesSearchClearButtonStyle}"
                        Command="{Binding ClearSupportedGamesWikiSearchCommand}"
                        Visibility="{Binding HasSupportedGamesWikiSearchText, Converter={StaticResource BooleanToVisibilityConverter}}"
                        ToolTip="{Binding Strings.SupportedGamesWikiClearSearchTooltip}"
                        AutomationProperties.Name="{Binding Strings.SupportedGamesWikiClearSearchTooltip}">
                    <ui:SymbolIcon Symbol="Dismiss24"
                                   Width="16"
                                   Height="16"
                                   FontSize="16"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
            </Grid>
        </Grid>

        <ui:Card Grid.Row="1"
                 Style="{StaticResource PanelCardControlStyle}"
                 Padding="14,14,0,14"
                 Background="{DynamicResource SupportedGamesPanelBackgroundBrush}"
                 BorderBrush="{DynamicResource SupportedGamesCardBorderBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="{Binding Strings.RuntimeGameListLoading}"
                           FontSize="13"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Visibility="{Binding SupportedGamesWikiLoadingVisibility}" />

                <TextBlock Grid.Row="1"
                           Margin="0,8,0,0"
                           Text="{Binding SupportedGamesWikiStatusText}"
                           FontSize="13"
                           Foreground="{DynamicResource AccentPrimaryBrush}"
                           Visibility="{Binding SupportedGamesWikiStatusVisibility}" />

                <ScrollViewer x:Name="SupportedGamesWikiScrollViewer"
                              Grid.Row="2"
                              Margin="0,10,0,0"
                              Background="{DynamicResource SupportedGamesPanelBackgroundBrush}"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              ScrollChanged="SupportedGamesWikiScrollViewer_OnScrollChanged"
                              SizeChanged="SupportedGamesWikiScrollViewer_OnSizeChanged">
                        <ItemsControl ItemsSource="{Binding SupportedGamesWikiRows}"
                                      Margin="{StaticResource WikiRowRightInset}">
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="RowCard"
                                            Style="{StaticResource SupportedGamesItemCardStyle}">
                                        <Grid MinWidth="0"
                                              ClipToBounds="True">
                                            <Grid MinWidth="0"
                                                  ClipToBounds="True">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0"
                                                        Width="{Binding CoverImageWidthDip}"
                                                        Height="{Binding CoverImageHeightDip}"
                                                        VerticalAlignment="Center"
                                                        Style="{StaticResource WikiCoverFrameStyle}">
                                                    <Border CornerRadius="{StaticResource WikiCoverCornerRadius}">
                                                        <Border.Background>
                                                            <ImageBrush ImageSource="{Binding CoverImage}"
                                                                        Stretch="UniformToFill" />
                                                        </Border.Background>
                                                    </Border>
                                                </Border>

                                                <Grid Grid.Column="2"
                                                      MinWidth="0"
                                                      VerticalAlignment="Center">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <TextBlock Grid.Row="0"
                                                               Text="{Binding DisplayTitle}"
                                                               Style="{StaticResource WikiGameTitleTextStyle}"
                                                               ToolTip="{Binding DisplayTitle}" />

                                                    <Grid x:Name="WideVendorLayout"
                                                          Grid.Row="1"
                                                          MinWidth="0"
                                                          Margin="0,8,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="8" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="8" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>

                                                        <Border Grid.Column="0"
                                                                Style="{StaticResource WikiVendorBadgeStyle}">
                                                            <StackPanel MinWidth="0">
                                                                <TextBlock Text="Intel" Style="{StaticResource WikiVendorIntelTextStyle}" />
                                                                <TextBlock Text="{Binding IntelText}" Style="{StaticResource WikiVendorValueTextStyle}" Margin="0,2,0,0" />
                                                            </StackPanel>
                                                        </Border>

                                                        <Border Grid.Column="2"
                                                                Style="{StaticResource WikiVendorBadgeStyle}">
                                                            <StackPanel MinWidth="0">
                                                                <TextBlock Text="AMD" Style="{StaticResource WikiVendorAmdTextStyle}" />
                                                                <TextBlock Text="{Binding AmdText}" Style="{StaticResource WikiVendorValueTextStyle}" Margin="0,2,0,0" />
                                                            </StackPanel>
                                                        </Border>

                                                        <Border Grid.Column="4"
                                                                Style="{StaticResource WikiVendorBadgeStyle}">
                                                            <StackPanel MinWidth="0">
                                                                <TextBlock Text="NVIDIA" Style="{StaticResource WikiVendorNvidiaTextStyle}" />
                                                                <TextBlock Text="{Binding NvidiaText}" Style="{StaticResource WikiVendorValueTextStyle}" Margin="0,2,0,0" />
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>

                                                    <StackPanel x:Name="CompactVendorLayout"
                                                                Grid.Row="1"
                                                                MinWidth="0"
                                                                Margin="0,8,0,0"
                                                                Visibility="Collapsed">
                                                        <Border Style="{StaticResource WikiVendorBadgeStyle}" Margin="0,0,0,6">
                                                            <StackPanel MinWidth="0">
                                                                <TextBlock Text="Intel" Style="{StaticResource WikiVendorIntelTextStyle}" />
                                                                <TextBlock Text="{Binding IntelText}" Style="{StaticResource WikiVendorValueTextStyle}" Margin="0,2,0,0" />
                                                            </StackPanel>
                                                        </Border>

                                                        <Border Style="{StaticResource WikiVendorBadgeStyle}" Margin="0,0,0,6">
                                                            <StackPanel MinWidth="0">
                                                                <TextBlock Text="AMD" Style="{StaticResource WikiVendorAmdTextStyle}" />
                                                                <TextBlock Text="{Binding AmdText}" Style="{StaticResource WikiVendorValueTextStyle}" Margin="0,2,0,0" />
                                                            </StackPanel>
                                                        </Border>

                                                        <Border Style="{StaticResource WikiVendorBadgeStyle}">
                                                            <StackPanel MinWidth="0">
                                                                <TextBlock Text="NVIDIA" Style="{StaticResource WikiVendorNvidiaTextStyle}" />
                                                                <TextBlock Text="{Binding NvidiaText}" Style="{StaticResource WikiVendorValueTextStyle}" Margin="0,2,0,0" />
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}, Converter={StaticResource LessThanDoubleConverter}, ConverterParameter=820}"
                                                     Value="True">
                                            <Setter TargetName="WideVendorLayout" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="CompactVendorLayout" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                </ScrollViewer>

                <TextBlock Grid.Row="3"
                           Margin="0,10,0,0"
                           Text="{Binding SupportedGamesWikiEmptyText}"
                           FontSize="13"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Visibility="{Binding SupportedGamesWikiEmptyVisibility}" />
            </Grid>
        </ui:Card>
    </Grid>
</UserControl>
