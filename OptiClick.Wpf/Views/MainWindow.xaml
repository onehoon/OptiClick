<ui:FluentWindow x:Class="OptiClickShell.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:controls="clr-namespace:OptiClick.Wpf.Controls"
                 xmlns:navigation="clr-namespace:OptiClick.Wpf.Shell.Navigation"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:sections="clr-namespace:OptiClick.Wpf.Views.Sections"
                 x:Name="ShellWindow"
                 Title="{Binding WindowTitleWithVersion}"
                 Icon="pack://application:,,,/Assets/AppIcon.ico"
                 Width="1130"
                 Height="660"
                 MinWidth="950"
                 MinHeight="635"
                 WindowStartupLocation="CenterScreen"
                 UseLayoutRounding="True"
                 SnapsToDevicePixels="True"
                 TextOptions.TextFormattingMode="Display"
                 TextOptions.TextRenderingMode="ClearType"
                 Background="{DynamicResource AppBackgroundBrush}"
                 WindowCornerPreference="Round"
                 WindowBackdropType="None"
                 ExtendsContentIntoTitleBar="True"
                 PreviewKeyDown="Window_OnPreviewKeyDown">
    <ui:FluentWindow.Resources>
        <DataTemplate x:Key="HomeSectionTemplate">
            <sections:HomeSectionView DataContext="{Binding Home}" />
        </DataTemplate>
        <DataTemplate x:Key="SupportedGamesWikiSectionTemplate">
            <sections:SupportedGamesWikiSectionView DataContext="{Binding SupportedGames}" />
        </DataTemplate>
        <DataTemplate x:Key="ScanSectionTemplate">
            <sections:ScanSectionView DataContext="{Binding Scan}" />
        </DataTemplate>
        <DataTemplate x:Key="OptiScalerSectionTemplate">
            <sections:OptiScalerSectionView DataContext="{Binding OptiScaler}" />
        </DataTemplate>
        <DataTemplate x:Key="SettingsSectionTemplate">
            <sections:SettingsSectionView DataContext="{Binding Settings}" />
        </DataTemplate>
    </ui:FluentWindow.Resources>
    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <Ellipse Width="620"
                 Height="620"
                 Grid.Row="0"
                 Grid.RowSpan="2"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Top"
                Margin="-140,0,0,0"
                IsHitTestVisible="False"
                 Opacity="1">
            <Ellipse.Fill>
                <RadialGradientBrush RadiusX="0.5" RadiusY="0.5"
                                     ColorInterpolationMode="SRgbLinearInterpolation">
                    <GradientStop Color="{DynamicResource ShellAmbientBlueColor}" Offset="0" />
                    <GradientStop Color="{DynamicResource ShellAmbientBlueFadeColor}" Offset="0.7" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Ellipse Width="560"
                 Height="560"
                 Grid.Row="1"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Top"
                Margin="0,-60,-120,0"
                IsHitTestVisible="False"
                 Opacity="1">
            <Ellipse.Fill>
                <RadialGradientBrush RadiusX="0.5" RadiusY="0.5"
                                     ColorInterpolationMode="SRgbLinearInterpolation">
                    <GradientStop Color="{DynamicResource ShellAmbientPurpleColor}" Offset="0" />
                    <GradientStop Color="{DynamicResource ShellAmbientPurpleFadeColor}" Offset="0.7" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Border Grid.Row="0"
                Margin="0"
                Background="Transparent"
                BorderBrush="{DynamicResource ShellTitleBarBorderBrush}"
                BorderThickness="0"
                CornerRadius="0"
                MouseLeftButtonDown="TopBar_OnMouseLeftButtonDown">
            <Border.Resources>
                <Style x:Key="CaptionButtonStyle" TargetType="Button">
                    <Setter Property="Width" Value="22" />
                    <Setter Property="Height" Value="36" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderBrush" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                    <Setter Property="FontFamily" Value="{StaticResource IconFontFamily}" />
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Root"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      RecognizesAccessKey="False" />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                <Style x:Key="CaptionCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
                    <Setter Property="FontSize" Value="12" />
                </Style>
                <Style x:Key="CaptionDotIdleStyle" TargetType="Ellipse">
                    <Setter Property="Fill" Value="{DynamicResource CaptionDotIdleBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                            <Setter Property="Fill" Value="{DynamicResource TextPrimaryBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsPressed, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                            <Setter Property="Fill" Value="{DynamicResource TextPrimaryBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
                <Style x:Key="CaptionDotCloseStyle" TargetType="Ellipse">
                    <Setter Property="Fill" Value="{DynamicResource CaptionDotCloseBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                            <Setter Property="Fill" Value="{DynamicResource CaptionDotCloseHoverBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsPressed, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                            <Setter Property="Fill" Value="{DynamicResource CaptionDotCloseHoverBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Resources>
                <Grid Height="40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding WindowTitleWithVersion}"
                           Margin="17,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontSize="13.5"
                           FontWeight="SemiBold" />

                <Button Grid.Column="1"
                        VerticalAlignment="Center"
                        Style="{StaticResource CaptionButtonStyle}"
                        ToolTip="Minimize"
                        Click="MinimizeButton_OnClick">
                    <Ellipse Width="12"
                             Height="12"
                             Style="{StaticResource CaptionDotIdleStyle}" />
                </Button>

                <Button x:Name="MaximizeRestoreButton"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Style="{StaticResource CaptionButtonStyle}"
                        ToolTip="Maximize / Restore"
                        Click="MaximizeRestoreButton_OnClick">
                    <Ellipse Width="12"
                             Height="12"
                             Style="{StaticResource CaptionDotIdleStyle}" />
                </Button>

                <Button Grid.Column="3"
                        Margin="0,0,5,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource CaptionCloseButtonStyle}"
                        ToolTip="Close"
                        Click="CloseButton_OnClick">
                    <Ellipse Width="12"
                             Height="12"
                             Style="{StaticResource CaptionDotCloseStyle}" />
                </Button>
                </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{StaticResource ShellSideRailWidth}" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource SideRailShellStyle}">
                <Grid Margin="0,5,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0"
                                Margin="8,3,8,0">
                        <Button Command="{Binding Commands.ShowHomeCommand}"
                                   Tag="{Binding Navigation.IsHomeViewActive}"
                                   ToolTip="{Binding Strings.NavHome}"
                                   AutomationProperties.Name="{Binding Strings.NavHome}"
                                   AutomationProperties.PositionInSet="1"
                                   AutomationProperties.SizeOfSet="5"
                                   TabIndex="0"
                                   Style="{StaticResource SideRailIconButtonStyle}">
                            <Viewbox Width="26" Height="26">
                                <Path Data="M12 2.7 2.9 10.2c-.55.45-.22 1.35.48 1.35H4.4v8.35c0 .6.48 1.08 1.08 1.08h3.9v-6.1c0-.5.4-.9.9-.9h3.44c.5 0 .9.4.9.9v6.1h3.9c.6 0 1.08-.48 1.08-1.08v-8.35h1.02c.7 0 1.03-.9.48-1.35L12 2.7Z"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Stretch="Uniform" />
                            </Viewbox>
                        </Button>

                        <Button Command="{Binding Commands.ShowScanViewCommand}"
                                   Tag="{Binding Navigation.IsScanViewActive}"
                                   ToolTip="{Binding Strings.NavScan}"
                                   AutomationProperties.Name="{Binding Strings.NavScan}"
                                   AutomationProperties.PositionInSet="2"
                                   AutomationProperties.SizeOfSet="5"
                                   TabIndex="1"
                                   Style="{StaticResource SideRailIconButtonStyle}">
                            <Viewbox Width="25" Height="25">
                                <Canvas Width="24" Height="24">
                                    <Ellipse Canvas.Left="3.8"
                                             Canvas.Top="3.8"
                                             Width="13.4"
                                             Height="13.4"
                                             Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                             StrokeThickness="2.2" />
                                    <Line X1="15.4"
                                          Y1="15.4"
                                          X2="21"
                                          Y2="21"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="2.2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" />
                                </Canvas>
                            </Viewbox>
                        </Button>

                        <Button Command="{Binding Commands.ShowSupportedGamesWikiViewCommand}"
                                   Tag="{Binding Navigation.IsSupportedGamesWikiViewActive}"
                                   ToolTip="{Binding Strings.NavSupportedGamesWiki}"
                                   AutomationProperties.Name="{Binding Strings.NavSupportedGamesWiki}"
                                   AutomationProperties.PositionInSet="3"
                                   AutomationProperties.SizeOfSet="5"
                                   TabIndex="2"
                                   Style="{StaticResource SideRailIconButtonStyle}">
                            <Viewbox Width="27" Height="27">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M7 6.5h10a4.5 4.5 0 0 1 4.47 5.03l-.6 5.1a2.3 2.3 0 0 1-4.1 1.16L15.2 15.5H8.8l-1.57 2.29a2.3 2.3 0 0 1-4.1-1.16l-.6-5.1A4.5 4.5 0 0 1 7 6.5Z"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    <Rectangle Canvas.Left="6"
                                               Canvas.Top="10"
                                               Width="1.6"
                                               Height="4"
                                               RadiusX=".4"
                                               RadiusY=".4"
                                               Fill="{Binding Background, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    <Rectangle Canvas.Left="4.2"
                                               Canvas.Top="11.2"
                                               Width="4"
                                               Height="1.6"
                                               RadiusX=".4"
                                               RadiusY=".4"
                                               Fill="{Binding Background, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    <Ellipse Canvas.Left="15.9"
                                             Canvas.Top="8.9"
                                             Width="2.2"
                                             Height="2.2"
                                             Fill="{Binding Background, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    <Ellipse Canvas.Left="18.1"
                                             Canvas.Top="11.1"
                                             Width="2.2"
                                             Height="2.2"
                                             Fill="{Binding Background, RelativeSource={RelativeSource AncestorType=Button}}" />
                                </Canvas>
                            </Viewbox>
                        </Button>

                        <Button Command="{Binding Commands.ShowOptiScalerCommand}"
                                   Tag="{Binding Navigation.IsOptiScalerViewActive}"
                                   ToolTip="{Binding Strings.NavOptiScaler}"
                                   AutomationProperties.Name="{Binding Strings.NavOptiScaler}"
                                   AutomationProperties.PositionInSet="4"
                                   AutomationProperties.SizeOfSet="5"
                                   TabIndex="3"
                                   Style="{StaticResource SideRailIconButtonStyle}">
                            <Viewbox Width="26" Height="26">
                                <Canvas Width="24" Height="24">
                                    <Ellipse Canvas.Left="3.7"
                                             Canvas.Top="3.7"
                                             Width="16.6"
                                             Height="16.6"
                                             Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                             StrokeThickness="2" />
                                    <Line X1="12"
                                          Y1="12"
                                          X2="15.6"
                                          Y2="7.8"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" />
                                    <Ellipse Canvas.Left="10.7"
                                             Canvas.Top="10.7"
                                             Width="2.6"
                                             Height="2.6"
                                             Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                </Canvas>
                            </Viewbox>
                        </Button>
                    </StackPanel>

                    <Button Grid.Row="1"
                            Command="{Binding Commands.ShowSettingsCommand}"
                            Tag="{Binding Navigation.IsSettingsViewActive}"
                            ToolTip="{Binding Strings.NavSettings}"
                            AutomationProperties.Name="{Binding Strings.NavSettings}"
                            AutomationProperties.PositionInSet="5"
                            AutomationProperties.SizeOfSet="5"
                            TabIndex="4"
                            Style="{StaticResource SideRailFooterIconButtonStyle}">
                        <Viewbox Width="24"
                                 Height="24"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center">
                            <Path Data="M12 8.4a3.6 3.6 0 1 0 0 7.2 3.6 3.6 0 0 0 0-7.2Zm9.3 2.5-1.7-.4a7.4 7.4 0 0 0-.6-1.5l1-1.5a.7.7 0 0 0-.1-.9l-1.4-1.4a.7.7 0 0 0-.9-.1l-1.5 1a7.4 7.4 0 0 0-1.5-.6l-.4-1.7a.7.7 0 0 0-.7-.5h-2a.7.7 0 0 0-.7.5l-.4 1.7a7.4 7.4 0 0 0-1.5.6l-1.5-1a.7.7 0 0 0-.9.1L4.9 6.6a.7.7 0 0 0-.1.9l1 1.5a7.4 7.4 0 0 0-.6 1.5l-1.7.4a.7.7 0 0 0-.5.7v2a.7.7 0 0 0 .5.7l1.7.4c.15.53.36 1.03.6 1.5l-1 1.5a.7.7 0 0 0 .1.9l1.4 1.4a.7.7 0 0 0 .9.1l1.5-1c.47.24.97.45 1.5.6l.4 1.7a.7.7 0 0 0 .7.5h2a.7.7 0 0 0 .7-.5l.4-1.7c.53-.15 1.03-.36 1.5-.6l1.5 1a.7.7 0 0 0 .9-.1l1.4-1.4a.7.7 0 0 0 .1-.9l-1-1.5c.24-.47.45-.97.6-1.5l1.7-.4a.7.7 0 0 0 .5-.7v-2a.7.7 0 0 0-.5-.7Z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Viewbox>
                    </Button>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Style="{StaticResource ShellMainSurfaceStyle}">
                <Grid Margin="{StaticResource ShellMainContentMargin}">
                <Grid Margin="{StaticResource ShellViewContainerMargin}">
                    <ContentControl Content="{Binding DataContext, ElementName=ShellWindow}">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="ContentTemplate" Value="{StaticResource HomeSectionTemplate}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.Navigation.CurrentViewKind, ElementName=ShellWindow}"
                                                 Value="{x:Static navigation:ShellViewKind.SupportedGamesWiki}">
                                        <Setter Property="ContentTemplate" Value="{StaticResource SupportedGamesWikiSectionTemplate}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding DataContext.Navigation.CurrentViewKind, ElementName=ShellWindow}"
                                                 Value="{x:Static navigation:ShellViewKind.Scan}">
                                        <Setter Property="ContentTemplate" Value="{StaticResource ScanSectionTemplate}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding DataContext.Navigation.CurrentViewKind, ElementName=ShellWindow}"
                                                 Value="{x:Static navigation:ShellViewKind.OptiScaler}">
                                        <Setter Property="ContentTemplate" Value="{StaticResource OptiScalerSectionTemplate}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding DataContext.Navigation.CurrentViewKind, ElementName=ShellWindow}"
                                                 Value="{x:Static navigation:ShellViewKind.Settings}">
                                        <Setter Property="ContentTemplate" Value="{StaticResource SettingsSectionTemplate}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                </Grid>
                </Grid>
            </Border>

            <controls:DialogHost Grid.Column="0"
                                 Grid.ColumnSpan="2"
                                 HorizontalAlignment="Stretch"
                                 VerticalAlignment="Stretch"
                                 Panel.ZIndex="999"
                                 DataContext="{Binding DialogHost}" />
            <controls:InstallManagementDialogHost Grid.Column="0"
                                                  Grid.ColumnSpan="2"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Stretch"
                                                  Panel.ZIndex="1000"
                                                  DataContext="{Binding InstallManagementDialogHost}" />
        </Grid>

        <Border Grid.Row="2"
                Background="{DynamicResource ShellFooterBarBrush}"
                BorderBrush="{DynamicResource ShellFooterBorderBrush}"
                BorderThickness="0,1,0,0"
                Margin="0">
            <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{StaticResource ShellSideRailWidth}" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1"
                       Text="{Binding RuntimeHeader.DeviceGpuInlineText}"
                       Style="{StaticResource DeviceMetaTextStyle}"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Margin="0,-1,24,0"
                       TextAlignment="Right"
                       MaxWidth="700"
                       TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>

        <Grid Grid.Row="0"
              Grid.RowSpan="3"
              Panel.ZIndex="1900"
              Background="#CC000000"
              IsHitTestVisible="True"
              Visibility="{Binding ShellBusyState.OperationOverlayVisibility}">
            <StackPanel Width="440"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock Text="{Binding ShellBusyState.OperationOverlayMessage}"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontSize="22"
                           FontWeight="SemiBold"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
                <ProgressBar Width="360"
                             Height="4"
                             Margin="0,16,0,0"
                             HorizontalAlignment="Center"
                             Foreground="{DynamicResource AccentPrimaryBrush}"
                             IsIndeterminate="True" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="0"
              Grid.RowSpan="3"
              Panel.ZIndex="2000"
              Background="#CC000000"
              IsHitTestVisible="True"
              Visibility="{Binding StartupOverlay.StartupPreparationOverlayVisibility}">
            <StackPanel Width="440"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock Text="{Binding Strings.StartupPreparationTitle}"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontSize="20"
                           FontWeight="SemiBold"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
                <TextBlock Text="{Binding Strings.StartupPreparationBody}"
                           Margin="0,12,0,18"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="14"
                           LineHeight="21"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
                <ProgressBar Width="360"
                             Height="4"
                             HorizontalAlignment="Center"
                             Foreground="{DynamicResource AccentPrimaryBrush}"
                             IsIndeterminate="True" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
