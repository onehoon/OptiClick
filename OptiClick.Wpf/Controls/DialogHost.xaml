<UserControl x:Class="OptiClick.Wpf.Controls.DialogHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:OptiClick.Wpf.Controls"
             mc:Ignorable="d"
             Focusable="False"
             IsHitTestVisible="{Binding IsOpen}">
    <UserControl.Resources>
        <Style x:Key="StandardDialogVisibilityStyle" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentDialog.IsGpuSelectionDialog}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StandardDialogBodyVisibilityStyle" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentDialog.IsGpuSelectionDialog}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CurrentDialog.IsStartupAnnouncementDialog}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="GpuSelectionDialogVisibilityStyle" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentDialog.IsGpuSelectionDialog}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StartupAnnouncementDialogVisibilityStyle" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentDialog.IsStartupAnnouncementDialog}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DialogCardSizeStyle" TargetType="Border">
            <Setter Property="Width" Value="580" />
            <Setter Property="MinWidth" Value="460" />
            <Setter Property="MaxWidth" Value="640" />
            <Setter Property="MaxHeight" Value="620" />
            <Style.Triggers>
                <!-- Startup announcements vary a lot in length (multi-language notes, game lists,
                     etc.), so let the card size to its content instead of a fixed width: short
                     notices stay narrow, long ones grow up to MaxWidth before wrapping. -->
                <DataTrigger Binding="{Binding CurrentDialog.IsStartupAnnouncementDialog}" Value="True">
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="MinWidth" Value="580" />
                    <Setter Property="MaxWidth" Value="820" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid Visibility="{Binding OverlayVisibility}">
        <Rectangle Fill="#99000000"
                   MouseLeftButtonDown="Overlay_OnMouseLeftButtonDown" />

        <Border Style="{StaticResource DialogCardSizeStyle}"
                Background="{DynamicResource OptiDialogBackgroundBrush}"
                BorderBrush="{DynamicResource OptiDialogBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="18,16,18,14"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22"
                                  ShadowDepth="0"
                                  Opacity="0.26"
                                  Color="#000000" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <TextBlock Text="{Binding CurrentDialog.Title}"
                               FontSize="19"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource OptiDialogTitleBrush}" />
                </Grid>

                <ScrollViewer Grid.Row="1"
                              Margin="0,14,0,0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="False">
                <Grid>
                <StackPanel Style="{StaticResource StandardDialogBodyVisibilityStyle}">
                    <controls:PopupMarkupTextBlock Segments="{Binding CurrentDialog.SummaryInline}"
                                                   Foreground="{DynamicResource OptiDialogBodyBrush}"
                                                   FontSize="14"
                                                   TextWrapping="Wrap" />

                    <Border Background="{DynamicResource OptiDialogBackgroundBrush}"
                            BorderBrush="{DynamicResource OptiDialogBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,7"
                            Margin="0,10,0,0"
                            Visibility="{Binding CurrentDialog.HasErrorCode, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Foreground="{DynamicResource SubtleBrush}"
                                   FontFamily="{DynamicResource MonoFontFamily}"
                                   FontSize="12"
                                   Text="{Binding CurrentDialog.ErrorCode, StringFormat=Error code: {0}}" />
                    </Border>

                    <ItemsControl ItemsSource="{Binding CurrentDialog.ResolvedBulletItems}"
                                  Margin="0,10,0,0"
                                  Visibility="{Binding CurrentDialog.HasBullets, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="4"
                                             Height="4"
                                             Fill="{DynamicResource OptiDialogBodyBrush}"
                                             VerticalAlignment="Top"
                                             Margin="0,7,0,0" />
                                    <controls:PopupMarkupTextBlock Grid.Column="1"
                                                                   Segments="{Binding Inline}"
                                                                   Foreground="{DynamicResource OptiDialogTitleBrush}"
                                                                   FontSize="13"
                                                                   TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <CheckBox Margin="0,10,0,0"
                              Content="{Binding CurrentDialog.AcknowledgementText}"
                              IsChecked="{Binding CurrentDialog.IsAcknowledged, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Visibility="{Binding CurrentDialog.AcknowledgementVisibility}"
                              Foreground="{DynamicResource OptiDialogMutedBrush}" />

                    <TextBlock Margin="0,10,0,0"
                               Text="{Binding CurrentDialog.FooterText}"
                               Visibility="{Binding CurrentDialog.HasFooterText, Converter={StaticResource BooleanToVisibilityConverter}}"
                               Foreground="{DynamicResource OptiDialogTitleBrush}"
                               FontSize="12"
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Style="{StaticResource StartupAnnouncementDialogVisibilityStyle}">
                    <StackPanel Margin="0,14,0,0"
                                Visibility="{Binding CurrentDialog.HasNewGameSupportSection, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{Binding CurrentDialog.NewGameSupportTitle}"
                                   Foreground="{DynamicResource StartupAnnouncementWarningBrush}"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   Margin="0,0,0,5" />

                        <ItemsControl ItemsSource="{Binding CurrentDialog.NewGameSupportItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="4"
                                                 Height="4"
                                                 Fill="{DynamicResource OptiDialogMutedBrush}"
                                                 VerticalAlignment="Top"
                                                 Margin="0,7,0,0" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding}"
                                                   Foreground="{DynamicResource OptiDialogBodyBrush}"
                                                   FontSize="13"
                                                   TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding CurrentDialog.StartupWarningItems}"
                                  Margin="0,10,0,0"
                                  Visibility="{Binding CurrentDialog.HasStartupWarningItems, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Margin" Value="0,0,0,0" />
                                            <Style.Triggers>
                                                <!-- Extra space above the first item merged in from a new
                                                     source message, to visually separate messages. -->
                                                <DataTrigger Binding="{Binding IsNewMessageGroup}" Value="True">
                                                    <Setter Property="Margin" Value="0,10,0,0" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Margin" Value="0,0,0,7" />
                                                <Style.Triggers>
                                                    <!-- Shift the whole bullet (marker included) rightward per
                                                         [INDENT] level seen before its [DOT]. The Grid already
                                                         reserves 16px for the dot column, so keep this modest -
                                                         it stacks on top of that, not replaces it. -->
                                                    <DataTrigger Binding="{Binding IndentLevel}" Value="1">
                                                        <Setter Property="Margin" Value="10,0,0,7" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IndentLevel}" Value="2">
                                                        <Setter Property="Margin" Value="20,0,0,7" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="4"
                                                 Height="4"
                                                 Fill="{DynamicResource OptiDialogBodyBrush}"
                                                 VerticalAlignment="Top"
                                                 Margin="0,8,0,0">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Style.Triggers>
                                                        <!-- Heading/intro lines (text before the first [DOT]) aren't
                                                             bullets, so they render without the dot marker. -->
                                                        <DataTrigger Binding="{Binding IsHeading}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <controls:PopupMarkupTextBlock Segments="{Binding Inline}"
                                                                       Foreground="{DynamicResource OptiDialogBodyBrush}"
                                                                       FontSize="14"
                                                                       TextWrapping="Wrap">
                                            <controls:PopupMarkupTextBlock.Style>
                                                <Style TargetType="controls:PopupMarkupTextBlock">
                                                    <Setter Property="Grid.Column" Value="1" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsHeading}" Value="True">
                                                            <Setter Property="Grid.Column" Value="0" />
                                                            <Setter Property="Grid.ColumnSpan" Value="2" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </controls:PopupMarkupTextBlock.Style>
                                        </controls:PopupMarkupTextBlock>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Style="{StaticResource GpuSelectionDialogVisibilityStyle}">
                    <controls:PopupMarkupTextBlock Segments="{Binding CurrentDialog.SummaryInline}"
                                                   Foreground="{DynamicResource OptiDialogBodyBrush}"
                                                   FontSize="14"
                                                   TextWrapping="Wrap" />

                    <UniformGrid Columns="2"
                                 HorizontalAlignment="Center"
                                 Margin="0,20,0,0"
                                 Visibility="{Binding CurrentDialog.HasSecondaryButton, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Button x:Name="GpuPrimaryActionButton"
                                Style="{StaticResource GpuChoiceButtonStyle}"
                                Margin="4,0"
                                Width="206"
                                Height="42"
                                Background="{Binding CurrentDialog.PrimaryVendorButtonBackgroundBrush}"
                                BorderBrush="{Binding CurrentDialog.PrimaryVendorButtonBorderBrush}"
                                Content="{Binding CurrentDialog.PrimaryButtonText}"
                                Command="{Binding PrimaryCommand}"
                                IsEnabled="{Binding CurrentDialog.IsPrimaryEnabled}" />
                        <Button x:Name="GpuSecondaryActionButton"
                                Style="{StaticResource GpuChoiceButtonStyle}"
                                Margin="4,0"
                                Width="206"
                                Height="42"
                                Background="{Binding CurrentDialog.SecondaryVendorButtonBackgroundBrush}"
                                BorderBrush="{Binding CurrentDialog.SecondaryVendorButtonBorderBrush}"
                                Content="{Binding CurrentDialog.SecondaryButtonText}"
                                Command="{Binding SecondaryCommand}" />
                    </UniformGrid>
                </StackPanel>
                </Grid>
                </ScrollViewer>

                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,16,0,0"
                            Style="{StaticResource StandardDialogVisibilityStyle}">
                    <Button Content="{Binding CurrentDialog.SecondaryButtonText}"
                            Style="{StaticResource QuietButtonStyle}"
                            Margin="0,0,8,0"
                            MinWidth="108"
                            Command="{Binding SecondaryCommand}"
                            Visibility="{Binding CurrentDialog.HasSecondaryButton, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Button x:Name="PrimaryActionButton"
                            Content="{Binding CurrentDialog.PrimaryButtonText}"
                            Style="{Binding CurrentDialog, Converter={StaticResource DialogPrimaryButtonStyleConverter}}"
                            MinWidth="120"
                            Command="{Binding PrimaryCommand}"
                            IsEnabled="{Binding CurrentDialog.IsPrimaryEnabled}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
