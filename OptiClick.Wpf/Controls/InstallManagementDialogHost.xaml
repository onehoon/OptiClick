<UserControl x:Class="OptiClick.Wpf.Controls.InstallManagementDialogHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Focusable="False"
             IsHitTestVisible="{Binding IsOpen}">
    <Grid Visibility="{Binding OverlayVisibility}">
        <Rectangle Fill="#99000000"
                   MouseLeftButtonDown="Overlay_OnMouseLeftButtonDown" />

        <Border Width="560"
                MinWidth="420"
                MaxWidth="620"
                MaxHeight="420"
                Background="{DynamicResource OptiDialogBackgroundBrush}"
                BorderBrush="{DynamicResource OptiDialogBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="18,16,18,14"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22"
                                  ShadowDepth="0"
                                  Opacity="0.26"
                                  Color="#000000" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="{Binding CurrentDialog.Title}"
                           FontSize="19"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource OptiDialogTitleBrush}" />

                <TextBlock Grid.Row="1"
                           Margin="0,14,0,0"
                           Text="{Binding CurrentDialog.Message}"
                           Foreground="{DynamicResource OptiDialogBodyBrush}"
                           FontSize="14"
                           TextWrapping="Wrap" />

                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,16,0,0">
                    <Button x:Name="UninstallActionButton"
                            Content="{Binding CurrentDialog.DestructiveText}"
                            Style="{StaticResource DangerButtonStyle}"
                            Margin="0,0,8,0"
                            MinWidth="120"
                            Command="{Binding DestructiveCommand}" />
                    <Button x:Name="PrimaryActionButton"
                            Content="{Binding CurrentDialog.PrimaryText}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Margin="0,0,8,0"
                            MinWidth="120"
                            Command="{Binding PrimaryCommand}" />
                    <Button Content="{Binding CurrentDialog.CancelText}"
                            Style="{StaticResource QuietButtonStyle}"
                            MinWidth="108"
                            Command="{Binding CancelCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
