    <SolidColorBrush x:Key="GpuChoiceButtonHoverBackgroundBrush" Color="{DynamicResource SurfaceRaisedColor}" />
    <SolidColorBrush x:Key="GpuChoiceButtonPressedBackgroundBrush" Color="{DynamicResource SurfaceHoverColor}" />
    <SolidColorBrush x:Key="GpuChoiceButtonHoverOverlayBrush" Color="{DynamicResource SurfaceRaisedColor}" />
    <SolidColorBrush x:Key="GpuChoiceButtonBorderBrush" Color="{DynamicResource BorderColor}" />
    <SolidColorBrush x:Key="GpuChoiceButtonTextBrush" Color="{DynamicResource TextPrimaryColor}" />
