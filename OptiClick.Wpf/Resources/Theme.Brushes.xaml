    <SolidColorBrush x:Key="ShellAmbientBlueBrush" Color="{DynamicResource ShellAmbientBlueColor}" />
    <SolidColorBrush x:Key="ShellAmbientPurpleBrush" Color="{DynamicResource ShellAmbientPurpleColor}" />

    <LinearGradientBrush x:Key="SideRailBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#3C4C8C" Offset="0" />
        <GradientStop Color="{DynamicResource AppBackgroundColor}" Offset="0.4" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="DeviceInfoCardBackgroundBrush" Color="{DynamicResource DeviceInfoCardBackgroundColor}" />
    <SolidColorBrush x:Key="DeviceInfoCardBorderBrush" Color="{DynamicResource DeviceInfoCardBorderColor}" />
    <SolidColorBrush x:Key="CaptionButtonHoverBrush" Color="{DynamicResource CaptionButtonHoverColor}" />
