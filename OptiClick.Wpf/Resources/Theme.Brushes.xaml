    <SolidColorBrush x:Key="DangerButtonPressedBrush" Color="{DynamicResource DangerButtonPressedColor}" />
    <SolidColorBrush x:Key="DangerButtonForegroundBrush" Color="{DynamicResource DangerButtonForegroundColor}" />
    <SolidColorBrush x:Key="SuccessButtonBackgroundBrush" Color="{DynamicResource SuccessButtonBackgroundColor}" />
    <SolidColorBrush x:Key="SuccessButtonHoverBrush" Color="{DynamicResource SuccessButtonHoverColor}" />
    <SolidColorBrush x:Key="SuccessButtonPressedBrush" Color="{DynamicResource SuccessButtonPressedColor}" />
