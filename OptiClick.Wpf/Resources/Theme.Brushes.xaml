    <SolidColorBrush x:Key="NavItemActivePressedBorderBrush" Color="{DynamicResource NavItemActivePressedBorderColor}" />
    <SolidColorBrush x:Key="NavItemActiveHighlightBrush" Color="{DynamicResource NavItemActiveHighlightColor}" />
