    <SolidColorBrush x:Key="NavIconMutedBrush" Color="{DynamicResource NavIconMutedColor}" />
    <SolidColorBrush x:Key="NavBackgroundBrush" Color="{DynamicResource AppBackgroundColor}" />
    <SolidColorBrush x:Key="PanelBrush" Color="{DynamicResource SurfaceColor}" />
    <SolidColorBrush x:Key="PanelRaisedBrush" Color="{DynamicResource SurfaceRaisedColor}" />
