    <SolidColorBrush x:Key="GpuVendorAmdBrush" Color="#ED1C24" />
    <SolidColorBrush x:Key="GpuVendorIntelBrush" Color="#0071C5" />
    <SolidColorBrush x:Key="GpuVendorUnknownBrush" Color="#6B7280" />
