    <SolidColorBrush x:Key="NavSelectedGlowBrush" Color="{DynamicResource NavSelectedGlowColor}" />
    <SolidColorBrush x:Key="ReadyBadgeBorderBrush" Color="{DynamicResource ReadyBadgeBorderColor}" />
    <LinearGradientBrush x:Key="ShellTitleBarBackgroundBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#3A4570" Offset="0" />
        <GradientStop Color="{DynamicResource AppBackgroundColor}" Offset="0.2" />
        <GradientStop Color="{DynamicResource AppBackgroundColor}" Offset="0.8" />
        <GradientStop Color="#3A4570" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ShellMainSurfaceBackgroundBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#3A4570" Offset="0" />
        <GradientStop Color="{DynamicResource AppBackgroundColor}" Offset="0.08" />
        <GradientStop Color="{DynamicResource AppBackgroundColor}" Offset="0.92" />
        <GradientStop Color="#3A4570" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ShellTitleBarBorderBrush" Color="{DynamicResource BorderColor}" />
    <SolidColorBrush x:Key="ShellMainSurfaceBrush" Color="{DynamicResource AppBackgroundColor}" />
