    <SolidColorBrush x:Key="ButtonBorderHoverBrush" Color="{DynamicResource AccentPrimaryColor}" />
    <SolidColorBrush x:Key="ButtonBorderPressedBrush" Color="{DynamicResource AccentPrimaryColor}" />
