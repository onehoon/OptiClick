                         StartPoint="0,0"
                         EndPoint="1,1">
        <GradientStop Color="{DynamicResource PrimaryButtonGradientStartColor}" Offset="0" />
        <GradientStop Color="{DynamicResource PrimaryButtonGradientEndColor}" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PrimaryButtonHoverBrush"
                         StartPoint="0,0"
                         EndPoint="1,1">
        <GradientStop Color="{DynamicResource PrimaryButtonHoverGradientStartColor}" Offset="0" />
        <GradientStop Color="{DynamicResource PrimaryButtonHoverGradientEndColor}" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PrimaryButtonPressedBrush"
                         StartPoint="0,0"
                         EndPoint="1,1">
        <GradientStop Color="{DynamicResource PrimaryButtonPressedGradientStartColor}" Offset="0" />
        <GradientStop Color="{DynamicResource PrimaryButtonPressedGradientEndColor}" Offset="1" />
    </LinearGradientBrush>
