    <SolidColorBrush x:Key="CoverSelectedOverlayBrush" Color="{DynamicResource CoverSelectedOverlayColor}" />
    <SolidColorBrush x:Key="CoverSelectedInnerStrokeBrush" Color="{DynamicResource CoverSelectedInnerStrokeColor}" />
    <SolidColorBrush x:Key="NavSelectedAccentBrush" Color="{DynamicResource NavSelectedAccentColor}" />
    <SolidColorBrush x:Key="NavSelectedBackgroundBrush" Color="{DynamicResource NavSelectedBackgroundColor}" />
