<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Style x:Key="SideRailIconButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="48" />
        <Setter Property="Height" Value="48" />
        <Setter Property="MinWidth" Value="48" />
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="Margin" Value="0,4" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource NavIconMutedBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="ToolTipService.InitialShowDelay" Value="250" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="IsTabStop" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="BackgroundBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" />
                        <Rectangle x:Name="SelectionBar"
                                   Width="4"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Stretch"
                                   Margin="0,8,0,8"
                                   RadiusX="2"
                                   RadiusY="2"
                                   Fill="{StaticResource NavSelectedAccentBrush}"
                                   Opacity="0" />
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                     Value="True">
                            <Setter TargetName="SelectionBar" Property="Opacity" Value="1" />
                        </DataTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="SelectionBar" Property="Opacity" Value="0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource NavItemHoverBrush}" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource NavItemPressedBrush}" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="True">
                <Setter Property="Background" Value="{StaticResource NavItemActiveBrush}" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{StaticResource NavSelectedAccentBrush}" />
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="10"
                                          ShadowDepth="0"
                                          Opacity="0.20"
                                          Color="{StaticResource NavSelectedGlowColor}" />
                    </Setter.Value>
                </Setter>
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Tag" Value="True" />
                    <Condition Property="IsMouseOver" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{StaticResource NavItemActiveHoverBrush}" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource NavSelectedAccentBrush}" />
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Tag" Value="True" />
                    <Condition Property="IsPressed" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{StaticResource NavItemActivePressedBrush}" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource NavSelectedAccentBrush}" />
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
                <Setter Property="Cursor" Value="Arrow" />
                <Setter Property="Effect" Value="{x:Null}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SideRailFooterIconButtonStyle" TargetType="Button" BasedOn="{StaticResource SideRailIconButtonStyle}">
        <Setter Property="Margin" Value="{StaticResource ShellFooterButtonMargin}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SideRailShellStyle" TargetType="Border">
        <Setter Property="Margin" Value="{StaticResource ShellSideRailOuterMargin}" />
        <Setter Property="Background" Value="{StaticResource AppBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource ShellSideRailCornerRadius}" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="22"
                                  ShadowDepth="0"
                                  Opacity="0.08"
                                  Color="{DynamicResource BorderColor}" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SideRailBrandCardStyle" TargetType="Border">
        <Setter Property="Margin" Value="{StaticResource ShellBrandMargin}" />
        <Setter Property="Padding" Value="{StaticResource ShellBrandPadding}" />
        <Setter Property="CornerRadius" Value="{StaticResource ShellBrandCornerRadius}" />
        <Setter Property="Background" Value="{StaticResource ShellBrandCardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="ShellMainSurfaceStyle" TargetType="Border">
        <Setter Property="Margin" Value="{StaticResource ShellMainSurfaceMargin}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="{StaticResource AppBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource ShellMainSurfaceCornerRadius}" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="24"
                                  ShadowDepth="0"
                                  Opacity="0.10"
                                  Color="{DynamicResource BorderColor}" />
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
