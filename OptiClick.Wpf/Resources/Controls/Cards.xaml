<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Style x:Key="PanelCardControlStyle" TargetType="ui:Card">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{StaticResource PanelCardPadding}" />
    </Style>

    <Style x:Key="RaisedPanelCardControlStyle" TargetType="ui:Card" BasedOn="{StaticResource PanelCardControlStyle}">
        <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}" />
    </Style>

    <Style x:Key="StatusPillCardControlStyle" TargetType="ui:Card" BasedOn="{StaticResource PanelCardControlStyle}">
        <Setter Property="Padding" Value="{StaticResource StatusPillPadding}" />
    </Style>

    <Style x:Key="SectionListItemCardControlStyle" TargetType="ui:Card" BasedOn="{StaticResource RaisedPanelCardControlStyle}">
        <Setter Property="Padding" Value="{StaticResource ListItemPadding}" />
        <Setter Property="Margin" Value="{StaticResource ListItemMargin}" />
    </Style>

    <Style x:Key="SectionStatusCardControlStyle" TargetType="ui:Card" BasedOn="{StaticResource RaisedPanelCardControlStyle}">
        <Setter Property="Padding" Value="{StaticResource SectionStatusCardPadding}" />
        <Setter Property="Margin" Value="{StaticResource SectionStatusCardMargin}" />
    </Style>

    <Style x:Key="CoverCardButtonStyle" TargetType="Button">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="1" ScaleY="1" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Resources>
            <Storyboard x:Key="CoverCardHoverIn">
                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                 To="1.01"
                                 Duration="0:0:0.13" />
                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                 To="1.01"
                                 Duration="0:0:0.13" />
            </Storyboard>
            <Storyboard x:Key="CoverCardHoverOut">
                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                 To="1"
                                 Duration="0:0:0.13" />
                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                 To="1"
                                 Duration="0:0:0.13" />
            </Storyboard>
        </Style.Resources>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Panel.ZIndex" Value="5" />
            </Trigger>
            <EventTrigger RoutedEvent="MouseEnter">
                <BeginStoryboard Storyboard="{StaticResource CoverCardHoverIn}" />
            </EventTrigger>
            <EventTrigger RoutedEvent="MouseLeave">
                <BeginStoryboard Storyboard="{StaticResource CoverCardHoverOut}" />
            </EventTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
